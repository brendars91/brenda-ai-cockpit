# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. NUNCA commitees .env al control de versiones
# 3. Para generar ADMIN_SECRET seguro: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. Para producción, usa secrets manager (GitHub Secrets, AWS Secrets Manager, etc.)

# ============================================
# PROVEEDOR LLM
# ============================================
# Opciones: gemini, ollama, openai, mock
LLM_PROVIDER=gemini

# API Key para Gemini (obtenida en: https://aistudio.google.com/app/apikey)
LLM_API_KEY=your_gemini_api_key_here

# Configuración Ollama (opcional, para uso local)
OLLAMA_HOST=http://localhost:11434

# ============================================
# ADMINISTRACIÓN
# ============================================
# Secret para proteger endpoints administrativos
# Genera uno seguro con: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=change-me-in-production-generate-secure-random-string

# ============================================
# INTEGRACIONES EXTERNAS (Opcional)
# ============================================
# API Key para servicios externos si es necesario
RUBE_API_KEY=your_rube_api_key_here

# ============================================
# MONITOREO (Opcional)
# ============================================
GRAFANA_PASSWORD=admin_secure_password_change_me
