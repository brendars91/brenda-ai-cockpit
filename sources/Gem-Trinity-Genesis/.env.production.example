# ========================================
# .env.production example (no secrets)
# ========================================

# ============ Google AI ============
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash-exp

# ============ GitHub ============
GITHUB_TOKEN=
GITHUB_REPO=

# ============ Snyk Security ============
SNYK_TOKEN=

# ============ Composio/RUBE ============
COMPOSIO_API_KEY=

# ============ n8n ============
N8N_ENCRYPTION_KEY=

# ============ Cloudflare Tunnel ============
CLOUDFLARE_TUNNEL_TOKEN=

# ============ Ollama ============
OLLAMA_HOST=http://ollama:11434

# ============ Application ============
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ============ URLs (Tailscale) ============
BACKEND_URL=
FRONTEND_URL=
N8N_URL=
OLLAMA_URL=
