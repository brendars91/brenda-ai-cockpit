{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "GemBundleV1",
    "description": "Gem Bundle compilado por Gem Builder Compiler v1.0",
    "type": "object",
    "required": [
        "bundle_meta",
        "model_routing",
        "policies",
        "system_prompt",
        "tools"
    ],
    "additionalProperties": true,
    "properties": {
        "bundle_meta": {
            "type": "object",
            "required": [
                "use_case_id",
                "version"
            ],
            "properties": {
                "use_case_id": {
                    "type": "string",
                    "description": "Identificador único del caso de uso"
                },
                "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$",
                    "description": "Versión semántica del bundle"
                },
                "compiled_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp de compilación ISO 8601"
                },
                "compiler_version": {
                    "type": "string",
                    "description": "Versión del compilador usado"
                },
                "risk_score": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100,
                    "description": "Risk Score calculado (0-100)"
                }
            }
        },
        "model_routing": {
            "type": "object",
            "required": [
                "default_model"
            ],
            "properties": {
                "default_model": {
                    "type": "string",
                    "enum": [
                        "gemini-3-pro",
                        "gemini-flash"
                    ],
                    "description": "Modelo por defecto"
                },
                "fallback_model": {
                    "type": "string"
                },
                "reasoning_mode": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "extended",
                        "minimal"
                    ]
                }
            }
        },
        "policies": {
            "type": "object",
            "required": [
                "knowledge_states"
            ],
            "properties": {
                "knowledge_states": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "HECHO_VERIFICADO",
                            "INFERENCIA",
                            "ASUNCION",
                            "FALTAN_DATOS"
                        ]
                    },
                    "minItems": 2,
                    "description": "Estados de conocimiento para anti-alucinación"
                },
                "model_armor_enabled": {
                    "type": "boolean",
                    "default": false
                },
                "hitl_required": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "system_prompt": {
            "type": "object",
            "required": [
                "text"
            ],
            "properties": {
                "text": {
                    "type": "string",
                    "minLength": 10
                },
                "sha256_hash": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{12}$"
                },
                "tokens_approx": {
                    "type": "integer",
                    "minimum": 1
                },
                "sections": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "tools": {
            "type": "object",
            "required": [
                "contracts"
            ],
            "properties": {
                "contracts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": [
                            "name"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            },
                            "side_effects": {
                                "type": "boolean"
                            },
                            "dry_run_default": {
                                "type": "boolean"
                            },
                            "timeout_ms": {
                                "type": "integer",
                                "minimum": 100
                            },
                            "permissions": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "enum": [
                                        "read",
                                        "write"
                                    ]
                                }
                            }
                        }
                    }
                }
            }
        },
        "verifier": {
            "type": "object",
            "properties": {
                "verified": {
                    "type": "boolean"
                },
                "checks": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "checks_passed": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "warnings_count": {
                    "type": "integer"
                },
                "verified_at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        }
    }
}